S3_ACCESS_KEY_ID=news-podcast
S3_SECRET_ACCESS_KEY=news-podcast-development-secret
# Coordinated backupは明示的な `backup` profileでのみ起動する。
# 外部bucketはsourceと別endpoint/bucketで、versioningとObject Lockが必須。
BACKUP_ARCHIVE_ENDPOINT=
BACKUP_ARCHIVE_REGION=us-east-1
BACKUP_ARCHIVE_BUCKET=
BACKUP_ARCHIVE_ACCESS_KEY_ID=
BACKUP_ARCHIVE_SECRET_ACCESS_KEY=
BACKUP_ARCHIVE_FORCE_PATH_STYLE=false
BACKUP_ENCRYPTION_KEY_FILE_HOST=./.secrets/backup-encryption-key
BACKUP_INTERVAL_MS=86400000
BACKUP_DRILL_INTERVAL_MS=604800000
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4
BACKUP_RETAINED_GENERATIONS=30
BACKUP_IMMUTABLE_DAYS=35
VOICEVOX_BASE_URL=http://voicevox:50021
VOICEVOX_CHARACTER_NAME=ずんだもん
VOICEVOX_STYLE_NAME=
# Docker Compose内のcontext service用。host上で直接実行する場合はnats://127.0.0.1:4222を使う。
NATS_SERVERS=nats://nats:4222
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
