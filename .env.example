CONTENT_ARCHIVE_MAX_ASSET_TOTAL_BYTES=104857600
CONTENT_ARCHIVE_CLEANUP_INTERVAL_MS=21600000
CONTENT_ARCHIVE_ORPHAN_RETENTION_MS=86400000
