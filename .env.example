# Runtime secrets are user-managed. Tests and builds do not load this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
APP_ENV=development
PROVIDER_MODE=fake
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEV_AUTH_ENABLED=true
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000100
DEV_AUTH_PASSWORD=
IDENTITY_DATABASE_PATH=/app/data/identity-access.sqlite
IDENTITY_QUEUE_GROUP=identity-access
GATEWAY_PORT=4001
GATEWAY_HEALTH_PORT=4101
NATS_REQUEST_TIMEOUT_MS=2000
IDENTITY_HEALTH_PORT=4102
IDENTITY_HTTP_PORT=4002
IDENTITY_HTTP_ORIGIN=http://identity-access:4002
AUTH_PROXY_TIMEOUT_MS=5000
AUTH_PROXY_MAX_RESPONSE_BYTES=1048576
TELEMETRY_PROXY_TIMEOUT_MS=5000
TELEMETRY_PROXY_MAX_REQUEST_BYTES=1048576
TELEMETRY_PROXY_MAX_RESPONSE_BYTES=1048576
CONTENT_KNOWLEDGE_DATABASE_PATH=/app/data/content-knowledge.sqlite
CONTENT_HEALTH_PORT=4103
CONTENT_RPC_QUEUE_GROUP=content-knowledge
CONTENT_RSS_TIMEOUT_MS=10000
CONTENT_RSS_MAX_BYTES=2097152
CONTENT_RSS_INTERVAL_MS=300000
CONTENT_RSS_INITIAL_BACKOFF_MS=1000
CONTENT_RSS_MAX_BACKOFF_MS=30000
CONTENT_ENRICH_DAILY_LIMIT=200
CONTENT_ENRICH_INTERVAL_MS=60000
CONTENT_ENRICH_INITIAL_BACKOFF_MS=1000
CONTENT_ENRICH_MAX_BACKOFF_MS=30000
# Gatewayの手動archive deadlineもこの値を使い、NATS応答はさらに5秒待つ。
CONTENT_ARCHIVE_TIMEOUT_MS=30000
CONTENT_ARCHIVE_MAX_HTML_BYTES=5242880
CONTENT_ARCHIVE_MAX_ASSET_BYTES=20971520
