EPISODE_WORKER_RETRY_DELAY_MS=30000
EPISODE_WORKER_IDLE_MS=1000
EPISODE_COMPLETION_BATCH_SIZE=50
EPISODE_COMPLETION_INTERVAL_MS=1000
EPISODE_COMPLETION_INITIAL_BACKOFF_MS=1000
EPISODE_COMPLETION_MAX_BACKOFF_MS=30000
EPISODE_SCHEDULER_INTERVAL_MS=60000
EPISODE_SCHEDULER_FAILURE_BACKOFF_MS=5000
EPISODE_SCHEDULER_REQUEST_TIMEOUT_MS=5000
