EPISODE_PRODUCTION_QUEUE_GROUP=episode-production
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_MS=120000
VOICEVOX_REQUEST_TIMEOUT_MS=60000
VOICEVOX_MAXIMUM_AUDIO_BYTES=134217728
VOICEVOX_MAXIMUM_TEXT_CHARACTERS=200
PROVIDER_MAXIMUM_ATTEMPTS=3
PROVIDER_MAXIMUM_ELAPSED_MS=180000
PROVIDER_BASE_DELAY_MS=1000
