OTEL_TRACE_SAMPLE_RATE=1
TELEMETRY_PROXY_TOKEN=
VITE_TELEMETRY_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3100
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=
