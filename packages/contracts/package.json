{
  "name": "@news-podcast/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./openapi": "./src/generated/openapi.ts"
  },
  "scripts": {
    "build": "pnpm generate",
    "lint": "spectral lint --ruleset ../../.spectral.yaml openapi/openapi.yaml",
    "generate": "openapi-typescript openapi/openapi.yaml -o src/generated/openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.16.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
