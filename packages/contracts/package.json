{
  "name": "@news-podcast/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./openapi": "./src/generated/openapi.ts",
    "./agui": "./src/agui.ts"
  },
  "scripts": {
    "build": "pnpm generate",
    "lint": "spectral lint --ruleset ../../.spectral.yaml openapi/openapi.json",
    "generate:document": "tsx ../../apps/gateway/src/openapi/generate.ts",
    "generate:types": "openapi-typescript openapi/openapi.json -o src/generated/openapi.ts",
    "generate": "pnpm generate:document && pnpm generate:types",
    "check": "pnpm generate:document && openapi-typescript openapi/openapi.json --check -o src/generated/openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.16.3",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
