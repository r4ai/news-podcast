# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
RUN --mount=type=cache,id=news-podcast-pnpm-store,target=/pnpm/store \
    pnpm fetch --frozen-lockfile

COPY apps/gateway/package.json apps/gateway/package.json
COPY apps/state-backup/package.json apps/state-backup/package.json
COPY apps/watchdog/package.json apps/watchdog/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/kernel/package.json packages/kernel/package.json
COPY packages/nats-runtime/package.json packages/nats-runtime/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/persistence/package.json packages/persistence/package.json
COPY packages/protocols/package.json packages/protocols/package.json
COPY packages/service-runtime/package.json packages/service-runtime/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY services/content-knowledge/package.json services/content-knowledge/package.json
COPY services/episode-library/package.json services/episode-library/package.json
COPY services/episode-production/package.json services/episode-production/package.json
COPY services/identity-access/package.json services/identity-access/package.json
RUN --network=none \
    --mount=type=cache,id=news-podcast-pnpm-store,target=/pnpm/store \
    pnpm install --offline --frozen-lockfile

COPY apps ./apps
COPY packages ./packages
COPY services ./services
COPY scripts/sqlite-state.mjs ./scripts/sqlite-state.mjs

CMD ["pnpm", "build"]
