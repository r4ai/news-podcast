map $http_authorization $otel_authorized {
  default 0;
  "Bearer ${TELEMETRY_PROXY_TOKEN}" 1;
}

limit_req_zone $binary_remote_addr zone=otlp:10m rate=10r/s;

server {
  listen 443 ssl http2;
  server_name ${OTLP_DOMAIN};
  ssl_certificate /etc/letsencrypt/live/${OTLP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${OTLP_DOMAIN}/privkey.pem;
  client_max_body_size 256k;

  location ~ ^/v1/(traces|logs|metrics)$ {
    if ($otel_authorized = 0) { return 401; }
    limit_req zone=otlp burst=20 nodelay;
    proxy_pass http://otel-collector:4318;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / { return 404; }
}
