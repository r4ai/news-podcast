{
  "annotations": { "list": [] },
  "description": "Dependency-first troubleshooting: service graph, NATS/HTTP client spans, and external dependency logs.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Overview", "type": "link", "url": "/d/news-podcast-overview", "keepTime": true },
    { "title": "Service map", "type": "link", "url": "/d/news-podcast-service-map", "keepTime": true },
    { "title": "Service drilldown", "type": "link", "url": "/d/news-podcast-service-drilldown", "keepTime": true },
    { "title": "Telemetry platform", "type": "link", "url": "/d/news-podcast-platform", "keepTime": true }
  ],
  "panels": [
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Tempo service map uses the Prometheus service graph metrics configured in the Tempo datasource.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "nodes": { "mainStatUnit": "reqps", "secondaryStatUnit": "ms" }, "edges": { "mainStatUnit": "reqps", "secondaryStatUnit": "ms" } },
      "targets": [{ "queryType": "serviceMap", "refId": "A" }],
      "title": "Live dependency service map",
      "type": "nodeGraph"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (service_name, server_address) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_CLIENT\"}[5m]))", "legendFormat": "{{service_name}} → {{server_address}}", "range": true, "refId": "A" }],
      "title": "Client span rate by dependency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(traces_spanmetrics_duration_milliseconds_bucket{span_kind=\"SPAN_KIND_CLIENT\"}[5m])))", "legendFormat": "{{server_address}}", "range": true, "refId": "A", "exemplars": true }],
      "title": "Client span p95 — exemplars open Tempo",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_client_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service_name}}", "range": true, "refId": "A", "exemplars": true }],
      "title": "HTTP client p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 22 },
      "id": 5,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "editorMode": "code", "expr": "{service_name=~\"gateway|identity-access|content-knowledge|episode-production|episode-library\"} | detected_level =~ `error|warn`", "queryType": "range", "refId": "A" }],
      "title": "Dependency-related warnings/errors",
      "type": "logs"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 34 },
      "id": 6,
      "options": { "spanBar": { "type": "Tag", "tag": "server.address" } },
      "targets": [{ "limit": 100, "query": "{ span.kind = client && duration > 0ms }", "queryType": "traceql", "refId": "A", "tableType": "traces" }],
      "title": "Dependency traces — inspect NATS, database, VoiceVox, and storage spans",
      "type": "traces"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["news-podcast", "dependencies", "bottleneck", "managed"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "News Podcast / Dependencies",
  "uid": "news-podcast-dependencies",
  "version": 1
}
