{
  "annotations": { "list": [] },
  "description": "Bounded episode workflow health in diagnostic order: state, queue, stage, provider, checkpoint, and failure logs.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Overview", "type": "link", "url": "/d/news-podcast-overview", "keepTime": true },
    { "title": "Service map and traces", "type": "link", "url": "/d/news-podcast-service-map", "keepTime": true },
    { "title": "Correlated logs", "type": "link", "url": "/d/news-podcast-logs", "keepTime": true }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(episode_jobs{job_status=~\"queued|running|retrying\"})", "legendFormat": "active", "range": true, "refId": "A" }],
      "title": "Active jobs",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1200000 }, { "color": "red", "value": 1440000 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "max(episode_queue_oldest_age)", "legendFormat": "oldest", "range": true, "refId": "A" }],
      "title": "Oldest queue age",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(count_over_time({service_name=\"episode-production\"} |~ `retry|Retry` [$__range]))", "legendFormat": "retry diagnostics", "queryType": "range", "refId": "A" }],
      "title": "Retry diagnostics in range",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"episode-production\",status_code=\"STATUS_CODE_ERROR\"}[5m]))", "legendFormat": "error spans", "range": true, "refId": "A" }],
      "title": "Production error span rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "max by (job_status) (episode_jobs)", "legendFormat": "{{job_status}}", "range": true, "refId": "A" }],
      "title": "Job states",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"episode-production\"}[5m])))", "legendFormat": "{{span_name}}", "range": true, "refId": "A" }],
      "title": "Stage and operation p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_client_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service_name}}", "range": true, "refId": "A" }],
      "title": "Dependency client p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "{service_name=\"episode-production\"} |~ `checkpoint|lease`", "queryType": "range", "refId": "A" }],
      "title": "Checkpoint and lease diagnostics",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "editorMode": "code", "expr": "max(episode_cleanup_backlog)", "legendFormat": "cleanup backlog", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "max(episode_staging_bytes)", "legendFormat": "staging bytes", "range": true, "refId": "B" }
      ],
      "title": "Storage pressure",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "editorMode": "code", "expr": "max(episode_queue_oldest_age)", "legendFormat": "oldest ready age", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(episode_queue_wait_duration_bucket[5m])))", "legendFormat": "lease wait p95", "range": true, "refId": "B" }
      ],
      "title": "Queue age and lease wait",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 35, "lineWidth": 1, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (gen_ai_request_model, episode_script_prompt_version, episode_script_quality_prompt_version, quality_outcome, quality_reason) (increase(episode_script_quality_total[$__rate_interval]))", "legendFormat": "{{gen_ai_request_model}} · {{episode_script_prompt_version}} · {{episode_script_quality_prompt_version}} · {{quality_outcome}} · {{quality_reason}}", "range": true, "refId": "A" }],
      "title": "Script quality outcomes by model and prompt version",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 35, "lineWidth": 1, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (schedule_outcome) (increase(episode_schedule_outcomes_total[$__rate_interval]))", "legendFormat": "{{schedule_outcome}}", "range": true, "refId": "A" }],
      "title": "Daily schedule outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 37 },
      "id": 11,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "editorMode": "code", "expr": "{service_name=~\".*worker.*|.*episode.*\"} | detected_level =~ `error|warn`", "queryType": "range", "refId": "A" }],
      "title": "Production failures — open TraceID for the full pipeline",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["news-podcast", "episode", "workflow", "managed"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "News Podcast / Episode Production",
  "uid": "news-podcast-episode",
  "version": 1
}
