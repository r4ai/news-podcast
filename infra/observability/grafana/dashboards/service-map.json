{
  "annotations": { "list": [] },
  "description": "Service relationships generated from distributed spans, plus operation-level latency/errors and searchable traces.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Overview", "type": "link", "url": "/d/news-podcast-overview", "keepTime": true },
    { "title": "Logs", "type": "link", "url": "/d/news-podcast-logs", "keepTime": true }
  ],
  "panels": [
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Edges come from paired CLIENT/PRODUCER and SERVER/CONSUMER spans. Missing edges are instrumentation defects.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "nodes": { "mainStatUnit": "reqps", "secondaryStatUnit": "ms" }, "edges": { "mainStatUnit": "reqps", "secondaryStatUnit": "ms" } },
      "targets": [{ "queryType": "serviceMap", "refId": "A" }],
      "title": "Live service dependency graph",
      "type": "nodeGraph"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (client, server) (rate(traces_service_graph_request_total[5m]))", "legendFormat": "{{client}} → {{server}}", "range": true, "refId": "A" }],
      "title": "Edge request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total[5m])) / clamp_min(sum by (client, server) (rate(traces_service_graph_request_total[5m])), 0.001)", "legendFormat": "{{client}} → {{server}}", "range": true, "refId": "A" }],
      "title": "Edge error ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, client, server) (rate(traces_service_graph_request_server_seconds_bucket[5m])))", "legendFormat": "{{client}} → {{server}}", "range": true, "refId": "A" }],
      "title": "Edge p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 22 },
      "id": 5,
      "options": { "spanBar": { "type": "Tag", "tag": "http.route" } },
      "targets": [{ "limit": 100, "query": "{ resource.service.name =~ `$service` && duration > 0ms }", "queryType": "traceql", "refId": "A", "tableType": "traces" }],
      "title": "Traces — open one to jump to correlated logs and metrics",
      "type": "traces"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["news-podcast", "service-map", "tracing", "managed"],
  "templating": { "list": [{ "current": { "text": ".*", "value": ".*" }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "definition": "label_values(traces_spanmetrics_calls_total, service_name)", "includeAll": true, "allValue": ".*", "label": "Service", "multi": true, "name": "service", "query": { "query": "label_values(traces_spanmetrics_calls_total, service_name)", "refId": "VariableQuery" }, "refresh": 2, "type": "query" }] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "News Podcast / Service Map & Tracing",
  "uid": "news-podcast-service-map",
  "version": 1
}

