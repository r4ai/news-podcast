{
  "annotations": { "list": [] },
  "description": "Operation-level RED drilldown for one service, with direct trace and log correlation.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Overview", "type": "link", "url": "/d/news-podcast-overview", "keepTime": true },
    { "title": "Service map", "type": "link", "url": "/d/news-podcast-service-map", "keepTime": true },
    { "title": "Correlated logs", "type": "link", "url": "/d/news-podcast-logs", "keepTime": true }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\"}[5m]))", "legendFormat": "request/span rate", "range": true, "refId": "A" }],
      "title": "Service request / span rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\"}[5m])), 0.001)", "legendFormat": "error ratio", "range": true, "refId": "A" }],
      "title": "Service error ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[5m])))", "legendFormat": "p95", "range": true, "refId": "A" }],
      "title": "Service p95 span latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (span_name, span_kind) (rate(traces_spanmetrics_calls_total{service_name=\"$service\"}[5m]))", "legendFormat": "{{span_kind}} {{span_name}}", "range": true, "refId": "A" }],
      "title": "Operation rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, span_name, span_kind) (rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=\"$service\"}[5m])))", "legendFormat": "{{span_kind}} {{span_name}}", "range": true, "refId": "A", "exemplars": true }],
      "title": "Operation p95 latency — exemplars open Tempo",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 13 },
      "id": 6,
      "options": { "spanBar": { "type": "Tag", "tag": "http.route" } },
      "targets": [{ "limit": 100, "query": "{ resource.service.name = \"$service\" && duration > 0ms }", "queryType": "traceql", "refId": "A", "tableType": "traces" }],
      "title": "Service traces — open one to correlated logs and metrics",
      "type": "traces"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 25 },
      "id": 7,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "editorMode": "code", "expr": "{service_name=\"$service\"} | detected_level =~ `error|warn`", "queryType": "range", "refId": "A" }],
      "title": "Service warnings/errors — TraceID opens Tempo",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["news-podcast", "service", "drilldown", "managed"],
  "templating": { "list": [{ "current": { "text": "gateway", "value": "gateway" }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "definition": "label_values(traces_spanmetrics_calls_total, service_name)", "includeAll": false, "label": "Service", "name": "service", "query": { "query": "label_values(traces_spanmetrics_calls_total, service_name)", "refId": "VariableQuery" }, "refresh": 2, "type": "query" }] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "News Podcast / Service Drilldown",
  "uid": "news-podcast-service-drilldown",
  "version": 1
}
