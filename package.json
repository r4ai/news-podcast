{
  "name": "news-podcast-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:up": "docker compose up -d --build",
    "dev:down": "docker compose down",
    "dev:up:observed": "pnpm observability:infra:up && docker compose -f compose.yaml -f compose.observability.yaml up -d --build",
    "dev:down:observed": "docker compose -f compose.yaml -f compose.observability.yaml down && pnpm observability:infra:down",
    "lint": "oxlint && pnpm contract:lint && pnpm architecture:check",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "contract:lint": "pnpm --filter @news-podcast/contracts lint",
    "contract:generate": "pnpm --filter @news-podcast/contracts generate",
    "contract:check": "pnpm --filter @news-podcast/contracts check",
    "architecture:check": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:functional": "bash scripts/run-functional-e2e.sh",
    "test:coverage:functional": "bash scripts/run-functional-coverage.sh",
    "test:sqlite-state": "node --test scripts/sqlite-state.test.mjs",
    "state:migrate:functional-ddd": "node scripts/migrate-functional-ddd.mjs",
    "test:state-migration": "node --experimental-test-coverage --test scripts/migrate-functional-ddd.test.mjs",
    "test:visual": "pnpm --filter web test:visual",
    "storybook:build": "pnpm --filter web build-storybook",
    "setup:env": "node scripts/setup-env.mjs",
    "observability:infra:up": "bash scripts/observability-up.sh",
    "observability:infra:down": "docker compose -f infra/observability/compose.yaml down",
    "observability:validate": "bash scripts/validate-observability.sh"
  },
  "devDependencies": {
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.16.0"
}
