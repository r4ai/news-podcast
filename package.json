{
  "name": "news-podcast-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint && pnpm contract:lint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "contract:lint": "pnpm --filter @news-podcast/contracts lint",
    "contract:generate": "pnpm --filter @news-podcast/contracts generate",
    "storybook:build": "pnpm --filter web build-storybook"
  },
  "devDependencies": {
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.16.0"
}
