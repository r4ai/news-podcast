{
  "name": "@news-podcast/identity-access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/runtime/index.ts",
    "./domain": "./src/domain/index.ts",
    "./application": "./src/application/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "start": "tsx src/bootstrap.ts",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "@nats-io/transport-node": "3.4.0",
    "@news-podcast/kernel": "workspace:*",
    "@news-podcast/observability": "workspace:*",
    "@news-podcast/persistence": "workspace:*",
    "@news-podcast/protocols": "workspace:*",
    "@news-podcast/service-runtime": "workspace:*",
    "better-auth": "1.6.26",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
