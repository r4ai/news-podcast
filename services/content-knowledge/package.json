{
  "name": "@news-podcast/content-knowledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./application": "./src/application/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "start": "tsx src/bootstrap.ts",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:article-markdown:coverage": "vitest run --config vitest.article-markdown.config.ts",
    "test:article-markdown:live": "tsx scripts/article-markdown-live.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0",
    "@mozilla/readability": "0.6.0",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@news-podcast/ai-runtime": "workspace:*",
    "@news-podcast/kernel": "workspace:*",
    "@news-podcast/nats-runtime": "workspace:*",
    "@news-podcast/observability": "workspace:*",
    "@news-podcast/persistence": "workspace:*",
    "@news-podcast/protocols": "workspace:*",
    "@news-podcast/service-runtime": "workspace:*",
    "@vscode/vscode-languagedetection": "1.0.23",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.109",
    "fast-xml-parser": "5.10.1",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-mdast": "10.1.2",
    "ipaddr.js": "1.9.1",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-stringify": "11.0.0",
    "undici": "8.10.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/jsdom": "27.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.12.4",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
